# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# @defaultRequired=true @defaultSensitive=false
# ----------

NUXT_AZURE_AUTH_TENANT_ID=exec(`./scripts/get_secret.sh  pass://DCC-KI/TEXTMATE_FRONTEND/AUTH_TENANT_ID`)
NUXT_AZURE_AUTH_CLIENT_ID=exec(`./scripts/get_secret.sh  pass://DCC-KI/TEXTMATE_FRONTEND/AUTH_CLIENT_ID`)

# @sensitive
NUXT_AZURE_AUTH_CLIENT_SECRET=exec(`./scripts/get_secret.sh pass://DCC-KI/TEXTMATE_FRONTEND/AUTH_CLIENT_SECRET`)
NUXT_AZURE_AUTH_API_CLIENT_ID=exec(`./scripts/get_secret.sh pass://DCC-KI/TEXTMATE_FRONTEND/AUTH_API_CLIENT_ID`)

# @type=url
NUXT_AZURE_AUTH_ORIGIN="http://localhost:3000/api/auth"

# Auth secret for session encryption (generate with: openssl rand -base64 32)
# @sensitive
NUXT_AZURE_AUTH_SECRET=

# @type=url
LOGGER_LAYER_URI="github:DCC-BS/nuxt-layers/pino-logger"

# @type=url
API_URL="http://localhost:3000/api"
